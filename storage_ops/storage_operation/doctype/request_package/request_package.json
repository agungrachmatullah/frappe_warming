{
    "doctype": "DocType",
    "name": "Request Package",
    "module": "Storage Operation",
    "istable": 1,
    "editable_grid": 1,
    "fields": [
        {
            "fieldname": "product_id",
            "fieldtype": "Link",
            "options": "Item",
            "label": "Product",
            "in_list_view": 1
        },
        {
            "fieldname": "quantity",
            "fieldtype": "Int",
            "label": "Quantity",
            "default": "1",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "columns": 1,
            "fieldname": "uom",
            "fieldtype": "Link",
            "fetch_from": "product_id.stock_uom",
            "in_list_view": 1,
            "label": "UOM",
            "options": "UOM",
            "print_width": "100px",
            "reqd": 1
        },
        {"fieldname": "unit_price", "fieldtype": "Currency", "label": "Unit Price", "reqd": 1, "in_list_view": 1},
        {"fieldname": "discount_percent", "fieldtype": "Percent", "label": "Discount %", "in_list_view": 1},
        {"fieldname": "amount", "fieldtype": "Currency", "label": "Amount", "read_only": 1, "in_list_view": 1},
        {
            "fieldname": "notes",
            "fieldtype": "Small Text",
            "label": "Notes"
        }
    ],
    "permissions": [
        {"role": "Stock User", "read": 1, "write": 1, "create": 1},
        {"role": "Stock Manager", "read": 1, "write": 1, "submit": 1, "cancel": 1}
    ]
}